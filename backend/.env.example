# URL pooler Neon (requêtes normales)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# URL directe Neon (transactions avec FOR UPDATE, migrations)
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Serveur
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# CORS
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=change_me_with_a_long_random_secret
JWT_EXPIRES_IN=12h

# Admin (utilisé par db:seed uniquement)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# Paiement : mock | live
PAYMENT_MODE=mock

# Wave (requis si PAYMENT_MODE=live)
# WAVE_API_KEY=
# WAVE_WEBHOOK_SECRET=

# Orange Money (non configuré — voir TODO dans OrangeMoneyProvider)
# ORANGE_MONEY_API_KEY=
